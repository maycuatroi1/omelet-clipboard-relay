{
  "name": "@omelet/clipboard-relay",
  "version": "0.1.0",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.1"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test scripts",
    "test": "bun test",
    "test:contract": "bun test test/contract.test.ts",
    "test:ice-credentials": "bun test test/ice-credentials.test.ts",
    "test:token-shape": "bun test test/auth/token-shape.test.ts",
    "test:auth": "bun test test/auth/",
    "test:signal": "bun test test/signal/",
    "test:relay": "bun test test/relay/",
    "gen:proto": "bun run scripts/gen-proto.ts",
    "migrate": "bun run scripts/migrate.ts",
    "check:schema-allowlist": "bun run scripts/check-schema-allowlist.ts",
    "check:no-payload-log": "bun run scripts/check-no-payload-log.ts"
  },
  "dependencies": {
    "arctic": "^3.7.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.14",
    "jose": "^6.2.8",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.1.14",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.2"
  }
}
