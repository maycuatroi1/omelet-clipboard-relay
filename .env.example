# Local development defaults. Real values come from `evo cred` and Dokploy env at deploy time.
# Step 3 only needs PORT and LOG_LEVEL; the rest are placeholders filled in by later steps:
#   DATABASE_URL -> step 5 (postgres schema)
#   JWT_SECRET -> step 6 (auth-token seam)
#   TURN_STATIC_AUTH_SECRET -> step 8 (ice-config seam, coturn REST API)
#   TURN_HOST -> step 8 (public hostname of the TURN server)

PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://clipboard:clipboard@localhost:5432/clipboard
JWT_SECRET=change-me
TURN_STATIC_AUTH_SECRET=change-me
TURN_HOST=turn.clip.omelet.tech
